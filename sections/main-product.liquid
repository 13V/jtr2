{%- assign accent = settings.accent_color | default: '#d81222' -%}
{%- assign product = all_products[section.settings.product] | default: product -%}
<section class="jtr-wrap" style="padding:60px 40px 80px;">
  <div style="display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:start;" class="jtr-product-grid">
    <div>
      {%- if product.featured_image -%}
        <div style="position:relative;border:1px solid rgba(255,255,255,.08);background:#101013;overflow:hidden;aspect-ratio:1/1;">
          <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" style="width:100%;height:100%;object-fit:cover;">
        </div>
      {%- endif -%}
      {%- if product.images.size > 1 -%}
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px;">
          {%- for image in product.images limit: 8 -%}
            <div style="border:1px solid rgba(255,255,255,.08);overflow:hidden;aspect-ratio:1/1;background:#101013;">
              <img src="{{ image | image_url: width: 300 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div>
      {%- if product.type != blank -%}<div class="jtr-eyebrow" style="margin-bottom:12px;">{{ product.type }}</div>{%- endif -%}
      <h1 style="margin:0 0 14px;font-family:'Archivo Black',sans-serif;font-size:clamp(30px,4vw,52px);line-height:.95;text-transform:uppercase;letter-spacing:-.02em;">{{ product.title }}</h1>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px;">
        <span style="font-family:'Archivo Black',sans-serif;font-size:26px;color:{{ accent }};">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}<span style="font-family:'Space Mono',monospace;font-size:15px;color:#6b6b73;text-decoration:line-through;">{{ product.compare_at_price | money }}</span>{%- endif -%}
      </div>

      {%- form 'product', product -%}
        {%- unless product.has_only_default_variant -%}
          <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:22px;">
            {%- for option in product.options_with_values -%}
              <label style="display:block;">
                <span style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#8a8a92;display:block;margin-bottom:8px;">{{ option.name }}</span>
                <select name="options[{{ option.name | escape }}]" class="jtr-field">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endfor -%}
          </div>
        {%- endunless -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" {% unless product.available %}disabled{% endunless %} class="jtr-btn-fill" style="display:inline-flex;justify-content:center;width:100%;max-width:420px;padding:18px 26px;background:{% if product.available %}{{ accent }}{% else %}#2a2a2e{% endif %};color:#0a0a0b;font-family:'Space Mono',monospace;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;border:none;">
          {% if product.available %}Add to bag{% else %}Sold out{% endif %}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="jtr-rte" style="margin-top:34px;padding-top:28px;border-top:1px solid rgba(255,255,255,.08);">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  @media (max-width:860px){ .jtr-product-grid{grid-template-columns:1fr!important;} }
</style>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave blank on the product template." }
  ]
}
{% endschema %}
