{%- assign accent = settings.accent_color | default: '#d81222' -%}
<section class="jtr-wrap" style="padding:60px 40px 80px;min-height:50vh;">
  <h1 class="jtr-h2" style="margin-bottom:36px;">Your Bag</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div style="display:flex;flex-direction:column;gap:0;border-top:1px solid rgba(255,255,255,.1);">
        {%- for item in cart.items -%}
          <div style="display:grid;grid-template-columns:90px 1fr auto;gap:20px;align-items:center;padding:22px 0;border-bottom:1px solid rgba(255,255,255,.1);">
            <a href="{{ item.url }}" style="display:block;border:1px solid rgba(255,255,255,.08);overflow:hidden;aspect-ratio:1/1;background:#101013;">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" style="font-family:'Archivo Black',sans-serif;font-size:16px;text-transform:uppercase;letter-spacing:-.01em;">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<div style="font-family:'Space Mono',monospace;font-size:11px;color:#8a8a92;margin-top:4px;">{{ item.variant.title }}</div>{%- endunless -%}
              <div style="display:flex;align-items:center;gap:14px;margin-top:10px;">
                <input type="number" min="0" name="updates[]" value="{{ item.quantity }}" style="width:64px;padding:8px 10px;background:#101013;border:1px solid rgba(255,255,255,.16);color:#f4f3f1;font-family:'Space Mono',monospace;">
                <a href="{{ item.url_to_remove }}" style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#8a8a92;">Remove</a>
              </div>
            </div>
            <div style="font-family:'Archivo Black',sans-serif;font-size:16px;white-space:nowrap;">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;margin-top:30px;">
        <button type="submit" name="update" class="jtr-btn-ghost" style="padding:14px 22px;border:1px solid rgba(255,255,255,.22);color:#f4f3f1;background:transparent;font-family:'Space Mono',monospace;font-weight:700;font-size:12px;letter-spacing:.08em;text-transform:uppercase;">Update</button>
        <div style="display:flex;align-items:center;gap:24px;">
          <div style="text-align:right;">
            <div style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#8a8a92;">Subtotal</div>
            <div style="font-family:'Archivo Black',sans-serif;font-size:24px;">{{ cart.total_price | money }}</div>
          </div>
          <button type="submit" name="checkout" class="jtr-btn-fill" style="padding:18px 30px;background:{{ accent }};color:#0a0a0b;border:none;font-family:'Space Mono',monospace;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;">Checkout</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <p class="jtr-rte" style="margin-bottom:24px;">Your bag is empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="jtr-btn-fill" style="display:inline-flex;padding:16px 26px;background:{{ accent }};color:#0a0a0b;font-family:'Space Mono',monospace;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;">Shop the Drop →</a>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
