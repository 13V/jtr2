{%- assign accent = settings.accent_color | default: '#d81222' -%}
<section class="jtr-wrap" style="padding:60px 40px 90px;min-height:50vh;">
  <div class="jtr-eyebrow" style="margin-bottom:14px;">All collections</div>
  <h1 class="jtr-h2" style="margin-bottom:40px;">Browse the Garage</h1>
  <div class="jtr-grid-3">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="jtr-feat jtr-reveal" style="display:block;border:1px solid rgba(255,255,255,.08);background:#101013;overflow:hidden;">
        <div style="position:relative;aspect-ratio:4/3;overflow:hidden;background:#15151a;">
          {%- if collection.featured_image -%}<img class="jtr-grow" src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.title | escape }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">{%- endif -%}
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(10,10,11,.85));"></div>
          <h3 style="position:absolute;left:18px;bottom:16px;margin:0;font-family:'Archivo Black',sans-serif;font-size:20px;text-transform:uppercase;">{{ collection.title }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
