{%- assign accent = settings.accent_color | default: '#d81222' -%}
<section class="jtr-wrap" style="padding:60px 40px 80px;min-height:50vh;">
  <div class="jtr-eyebrow" style="margin-bottom:14px;">Search</div>
  <h1 class="jtr-h2" style="margin-bottom:26px;">Find your fix</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:0;border:2px solid rgba(255,255,255,.2);max-width:560px;margin-bottom:40px;">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search cars, apparel…" class="jtr-field" style="border:none;background:transparent;">
    <button type="submit" style="padding:14px 26px;border:none;background:{{ accent }};color:#0a0a0b;font-family:'Space Mono',monospace;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;">Go</button>
  </form>

  {%- if search.performed -%}
    <div class="jtr-eyebrow" style="color:#8a8a92;margin-bottom:24px;">{{ search.results_count }} result(s)</div>
    <div class="jtr-grid-4">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          <a href="{{ item.url }}" class="jtr-pcard jtr-reveal" style="display:block;border:1px solid rgba(255,255,255,.08);background:#101013;">
            <div style="position:relative;aspect-ratio:1/1;overflow:hidden;background:#15151a;">{%- if item.featured_image -%}<img src="{{ item.featured_image | image_url: width: 700 }}" alt="{{ item.title | escape }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">{%- endif -%}</div>
            <div style="padding:16px;"><h3 style="margin:0 0 8px;font-weight:700;font-size:16px;">{{ item.title }}</h3><span style="font-family:'Archivo Black',sans-serif;">{{ item.price | money }}</span></div>
          </a>
        {%- else -%}
          <a href="{{ item.url }}" class="jtr-reveal" style="display:block;border:1px solid rgba(255,255,255,.08);background:#101013;padding:20px;"><h3 style="margin:0;font-weight:700;font-size:16px;">{{ item.title }}</h3></a>
        {%- endif -%}
      {%- else -%}
        <p class="jtr-rte">No results. Try another search.</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
