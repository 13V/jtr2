{%- assign accent = settings.accent_color | default: '#d81222' -%}
<div style="background:{{ accent }};color:#0a0a0b;overflow:hidden;white-space:nowrap;border-bottom:1px solid #0a0a0b;">
  <div style="display:inline-flex;gap:0;animation:jtr-marq {{ section.settings.speed }}s linear infinite;will-change:transform;">
    {%- for i in (1..2) -%}
      <span style="display:inline-flex;gap:38px;padding:9px 19px;font-family:'Space Mono',monospace;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endfor -%}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Scroll speed", "default": 26 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "✦ Free AU shipping over $100" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "message", "settings": { "text": "✦ Free AU shipping over $100" } },
      { "type": "message", "settings": { "text": "✦ Limited drops — gone is gone" } },
      { "type": "message", "settings": { "text": "✦ Genuine JDM & AUDM" } },
      { "type": "message", "settings": { "text": "✦ Adelaide-built · Est. 2026" } },
      { "type": "message", "settings": { "text": "✦ Honest listings, real history" } }
    ]
  }
}
{% endschema %}
