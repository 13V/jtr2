{%- assign accent = settings.accent_color | default: '#d81222' -%}
<section class="jtr-wrap" style="padding:60px 40px 80px;">
  <div style="margin-bottom:40px;">
    <div class="jtr-eyebrow" style="margin-bottom:14px;">JT-R Garage</div>
    <h1 class="jtr-h2">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="jtr-rte" style="margin-top:16px;max-width:640px;">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- paginate collection.products by 16 -%}
  <div class="jtr-grid-4">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="jtr-pcard jtr-reveal" data-tags="{{ product.tags | join: ' ' | downcase }}" style="display:block;border:1px solid rgba(255,255,255,.08);background:#101013;">
        <div style="position:relative;aspect-ratio:1/1;overflow:hidden;background:#15151a;">
          {%- if product.featured_image -%}<img class="jtr-pa" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">{%- endif -%}
          {%- if product.images[1] -%}<img class="jtr-pb" src="{{ product.images[1] | image_url: width: 700 }}" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">{%- endif -%}
          {%- unless product.available -%}<span style="position:absolute;top:12px;right:12px;padding:4px 9px;background:#0a0a0b;border:1px solid {{ accent }};color:{{ accent }};font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:.12em;">SOLD</span>{%- endunless -%}
        </div>
        <div style="padding:16px 16px 18px;">
          <div style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;color:#8a8a92;text-transform:uppercase;">{{ product.type | default: product.vendor }}</div>
          <h3 style="margin:7px 0 12px;font-family:'Archivo',sans-serif;font-weight:700;font-size:16.5px;">{{ product.title }}</h3>
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <span style="font-family:'Archivo Black',sans-serif;font-size:17px;">{{ product.price | money }}</span>
            <span style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.08em;color:{{ accent }};">VIEW →</span>
          </div>
        </div>
      </a>
    {%- else -%}
      <p class="jtr-rte">No products in this collection yet.</p>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <div style="display:flex;gap:14px;justify-content:center;margin-top:50px;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="jtr-link" style="color:{{ accent }};">← Prev</a>{%- endif -%}
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="jtr-link" style="color:{{ accent }};">Next →</a>{%- endif -%}
    </div>
  {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
