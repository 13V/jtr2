{%- assign accent = settings.accent_color | default: '#d81222' -%}
{%- if section.settings.logo != blank -%}
  {%- assign logo_url = section.settings.logo | image_url: width: 400 -%}
{%- else -%}
  {%- assign logo_url = 'jtr-logo.png' | asset_url -%}
{%- endif -%}

<footer style="background:#0a0a0b;padding:70px 40px 34px;border-top:1px solid rgba(255,255,255,.06);">
  <div class="jtr-footer-grid" style="max-width:1320px;margin:0 auto;">
    <div>
      <a href="{{ routes.root_url }}" style="display:inline-flex;align-items:center;margin-bottom:20px;">
        <img src="{{ logo_url }}" alt="{{ shop.name }}" style="height:60px;width:auto;display:block;">
      </a>
      <p style="margin:0 0 20px;max-width:340px;font-size:14px;line-height:1.6;color:#8a8a92;">{{ section.settings.description }}</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        {%- if settings.instagram_url != blank -%}<a href="{{ settings.instagram_url }}" class="jtr-chip" style="padding:9px 13px;border:1px solid rgba(255,255,255,.16);font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.08em;color:#cfcfd6;">Instagram</a>{%- endif -%}
        {%- if settings.tiktok_url != blank -%}<a href="{{ settings.tiktok_url }}" class="jtr-chip" style="padding:9px 13px;border:1px solid rgba(255,255,255,.16);font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.08em;color:#cfcfd6;">TikTok</a>{%- endif -%}
        {%- if settings.youtube_url != blank -%}<a href="{{ settings.youtube_url }}" class="jtr-chip" style="padding:9px 13px;border:1px solid rgba(255,255,255,.16);font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.08em;color:#cfcfd6;">YouTube</a>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h4 style="margin:0 0 16px;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#6b6b73;">{{ block.settings.heading }}</h4>
        <div style="display:flex;flex-direction:column;gap:11px;font-size:14px;color:#b6b6bd;">
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}" class="jtr-nav-link" style="transition:color .2s ease;">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div style="max-width:1320px;margin:48px auto 0;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
    <span style="font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.06em;color:#6b6b73;">© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ section.settings.location }}</span>
    <div style="display:flex;gap:8px;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.06em;color:#6b6b73;flex-wrap:wrap;">
      <span>Visa</span><span>·</span><span>MC</span><span>·</span><span>Amex</span><span>·</span><span>PayPal</span><span>·</span><span>Afterpay</span><span>·</span><span>Apple Pay</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "description", "label": "About text", "default": "Adelaide's home for genuine JDM & AUDM cars and Japanese-inspired streetwear. Cars and culture, straight out of South Australia." },
    { "type": "text", "id": "location", "label": "Location line", "default": "Adelaide, South Australia" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "column", "settings": { "heading": "Shop" } },
      { "type": "column", "settings": { "heading": "Company" } },
      { "type": "column", "settings": { "heading": "Support" } }
    ]
  }
}
{% endschema %}
