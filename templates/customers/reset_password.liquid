<section class="jtr-wrap" style="padding:60px 40px 80px;max-width:460px;min-height:50vh;">
  <h1 class="jtr-h2" style="font-size:clamp(28px,4.5vw,46px);margin-bottom:30px;">Reset password</h1>
  {%- form 'recover_customer_password' -%}
    {{ form.errors | default_errors }}
    {%- if form.posted_successfully? -%}
      <p style="font-family:'Space Mono',monospace;font-size:13px;color:#9a9aa2;margin-bottom:18px;">We've sent you a reset link.</p>
    {%- endif -%}
    <label class="jtr-eyebrow" style="display:block;color:#8a8a92;margin-bottom:8px;">Email</label>
    <input type="email" name="email" class="jtr-field" style="margin-bottom:22px;">
    <button type="submit" class="jtr-btn" style="width:100%;justify-content:center;">Send reset link</button>
  {%- endform -%}
  <p style="margin-top:20px;"><a href="{{ routes.account_login_url }}" class="jtr-link" style="color:var(--accent,#d81222);font-family:'Space Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:.08em;">← Back to log in</a></p>
</section>
