<section class="jtr-wrap" style="padding:60px 40px 80px;max-width:460px;min-height:50vh;">
  <h1 class="jtr-h2" style="font-size:clamp(30px,5vw,52px);margin-bottom:30px;">Create account</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <label class="jtr-eyebrow" style="display:block;color:#8a8a92;margin-bottom:8px;">First name</label>
    <input type="text" name="customer[first_name]" class="jtr-field" style="margin-bottom:18px;">
    <label class="jtr-eyebrow" style="display:block;color:#8a8a92;margin-bottom:8px;">Last name</label>
    <input type="text" name="customer[last_name]" class="jtr-field" style="margin-bottom:18px;">
    <label class="jtr-eyebrow" style="display:block;color:#8a8a92;margin-bottom:8px;">Email</label>
    <input type="email" name="customer[email]" class="jtr-field" style="margin-bottom:18px;">
    <label class="jtr-eyebrow" style="display:block;color:#8a8a92;margin-bottom:8px;">Password</label>
    <input type="password" name="customer[password]" class="jtr-field" style="margin-bottom:22px;">
    <button type="submit" class="jtr-btn" style="width:100%;justify-content:center;">Create account</button>
  {%- endform -%}
  <p style="margin-top:20px;font-family:'Space Mono',monospace;font-size:12px;color:#8a8a92;">Have an account? <a href="{{ routes.account_login_url }}" style="color:var(--accent,#d81222);">Log in →</a></p>
</section>
