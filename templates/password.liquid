<div style="margin-top:40px;max-width:420px;width:100%;">
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p style="color:var(--accent,#d81222);font-family:'Space Mono',monospace;font-size:12px;margin-bottom:12px;">Wrong password — try again.</p>
    {%- endif -%}
    <div style="display:flex;gap:0;border:2px solid rgba(255,255,255,.2);">
      <input type="password" name="password" placeholder="Enter password" class="jtr-field" style="border:none;background:transparent;">
      <button type="submit" style="padding:14px 24px;border:none;background:var(--accent,#d81222);color:#0a0a0b;font-family:'Space Mono',monospace;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;">Enter</button>
    </div>
  {%- endform -%}
</div>
