<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }} &ndash; Opening Soon</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>:root{ --accent: {{ settings.accent_color | default: '#d81222' }}; }</style>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body style="background:#0a0a0b;color:#f4f3f1;">
    <div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px;">
      <img src="{{ 'jtr-logo.png' | asset_url }}" alt="{{ shop.name }}" style="height:90px;width:auto;margin-bottom:30px;">
      <h1 style="font-family:'Archivo Black',sans-serif;text-transform:uppercase;font-size:clamp(32px,6vw,64px);margin:0 0 14px;">Opening Soon</h1>
      <p class="jtr-mono" style="color:#9a9aa2;letter-spacing:.1em;text-transform:uppercase;font-size:13px;">Cars &amp; culture · Adelaide, South Australia</p>
      {{ content_for_layout }}
    </div>
  </body>
</html>
